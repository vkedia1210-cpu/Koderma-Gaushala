ErrorDocument 404 /404.html
DirectoryIndex index.html index.php
Options -Indexes
<FilesMatch "^config\.php$">
  Require all denied
</FilesMatch>
# Pages: browsers must check for a fresh copy each visit (assets keep their long cache, versioned by ?v=)
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
